<?xml version="1.0" encoding="UTF-8"?>
<!-- filepath: /workspaces/coreee-v2/saas_base/views/saas_tenant_views.xml -->
<odoo>
    <data>
        <record id="view_saas_tenant_tree" model="ir.ui.view">
            <field name="name">saas.tenant.tree</field>
            <field name="model">saas.tenant</field>
            <field name="arch" type="xml">
                <tree string="Tenants" decoration-warning="current_users &gt;= max_users" 
                      decoration-danger="state == 'suspended'"
                      decoration-success="state == 'active'">
                    <field name="name"/>
                    <field name="subdomain"/>
                    <field name="plan_id"/>
                    <field name="current_users"/>
                    <field name="max_users"/>
                    <field name="email"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_saas_tenant_form" model="ir.ui.view">
            <field name="name">saas.tenant.form</field>
            <field name="model">saas.tenant</field>
            <field name="arch" type="xml">
                <form string="Tenant">
                    <header>
                        <button name="action_create_database" string="Create Database" 
                                type="object" class="btn-primary" states="draft"/>
                        <button name="action_activate" string="Activate" 
                                type="object" states="suspended,trial_expired" class="btn-success"/>
                        <button name="action_suspend" string="Suspend" 
                                type="object" states="active" class="btn-warning"/>
                        <button name="action_upgrade_plan" string="Upgrade Plan" 
                                type="object" states="active" class="btn-info"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,pending,active,suspended,trial_expired"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" class="oe_inline"/></h1>
                            <h3><field name="subdomain" class="text-muted oe_inline"/></h3>
                        </div>
                        <group>
                            <group string="Company Info">
                                <field name="name"/>
                                <field name="email"/>
                                <field name="contact_person"/>
                                <field name="phone"/>
                            </group>
                            <group string="Access">
                                <field name="subdomain"/>
                                <field name="custom_domain"/>
                            </group>
                        </group>
                        <group>
                            <group string="Database">
                                <field name="db_name" readonly="1"/>
                                <field name="admin_user" readonly="1"/>
                                <field name="admin_password" password="True"/>
                            </group>
                            <group string="Plan">
                                <field name="plan_id"/>
                                <field name="max_users"/>
                                <field name="current_users"/>
                                <field name="is_trial"/>
                            </group>
                        </group>
                        <group>
                            <group string="Trial Dates">
                                <field name="trial_start_date" readonly="1"/>
                                <field name="trial_end_date" readonly="1"/>
                            </group>
                            <group string="Company Details">
                                <field name="industry"/>
                                <field name="company_size"/>
                            </group>
                        </group>
                        <field name="notes" widget="html"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_saas_tenant_search" model="ir.ui.view">
            <field name="name">saas.tenant.search</field>
            <field name="model">saas.tenant</field>
            <field name="arch" type="xml">
                <search string="Search Tenants">
                    <field name="name" string="Name"/>
                    <field name="subdomain"/>
                    <field name="email"/>
                    <separator/>
                    <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                    <filter name="trial" string="Trial" domain="[('is_trial', '=', True)]"/>
                    <filter name="suspended" string="Suspended" domain="[('state', '=', 'suspended')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                        <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_saas_tenant" model="ir.actions.act_window">
            <field name="name">Tenants</field>
            <field name="res_model">saas.tenant</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_saas_tenant_search"/>
        </record>

        <menuitem id="menu_saas_tenant" name="Tenants" parent="menu_saas_root" 
                  action="saas_base.action_saas_tenant" sequence="10"/>
    </data>
</odoo>