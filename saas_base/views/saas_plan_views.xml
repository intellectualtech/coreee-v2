<?xml version="1.0" encoding="UTF-8"?>
<!-- filepath: /workspaces/coreee-v2/saas_base/views/saas_plan_views.xml -->
<odoo>
    <data>
        <record id="view_saas_plan_tree" model="ir.ui.view">
            <field name="name">saas.plan.tree</field>
            <field name="model">saas.plan</field>
            <field name="arch" type="xml">
                <tree string="SaaS Plans" decoration-muted="not active">
                    <field name="name"/>
                    <field name="price_monthly" sum="Total"/>
                    <field name="price_per_user"/>
                    <field name="max_users"/>
                    <field name="trial_days"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_saas_plan_form" model="ir.ui.view">
            <field name="name">saas.plan.form</field>
            <field name="model">saas.plan</field>
            <field name="arch" type="xml">
                <form string="SaaS Plan">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" class="oe_inline"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Basic Info">
                                <field name="active"/>
                                <field name="sort_order"/>
                            </group>
                        </group>
                        <group string="Pricing">
                            <group>
                                <field name="price_monthly"/>
                                <field name="price_yearly"/>
                                <field name="price_per_user"/>
                                <field name="setup_fee"/>
                            </group>
                        </group>
                        <group string="User Limits">
                            <group>
                                <field name="min_users"/>
                                <field name="max_users"/>
                            </group>
                        </group>
                        <group string="Trial">
                            <group>
                                <field name="trial_days"/>
                            </group>
                        </group>
                        <group string="Included Modules">
                            <field name="included_modules" widget="many2many_tags"/>
                        </group>
                        <field name="description" widget="html"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_saas_plan" model="ir.actions.act_window">
            <field name="name">SaaS Plans</field>
            <field name="res_model">saas.plan</field>
            <field name="view_mode">tree,form</field>
            <field name="help">Create and manage SaaS plans with pricing and features</field>
        </record>

        <menuitem id="menu_saas_plan" name="Plans" parent="menu_saas_root" 
                  action="saas_base.action_saas_plan" sequence="20"/>
    </data>
</odoo>