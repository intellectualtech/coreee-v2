<?xml version="1.0" encoding="UTF-8"?>
<!-- filepath: /workspaces/coreee-v2/saas_portal/views/portal_templates.xml -->
<odoo>
    <data>
        <template id="signup_template" name="SaaS Signup">
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <h1 class="mb-4">Create Your Account</h1>
                        <form id="saas_signup_form" class="form-horizontal">
                            <div class="form-group">
                                <label for="company_name">Company Name</label>
                                <input type="text" class="form-control" id="company_name" 
                                       name="company_name" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="email">Email Address</label>
                                <input type="email" class="form-control" id="email" 
                                       name="email" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="subdomain">Subdomain</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="subdomain" 
                                           name="subdomain" required="required"/>
                                    <span class="input-group-text">.yourdomain.com</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="contact_person">Contact Person</label>
                                <input type="text" class="form-control" id="contact_person" 
                                       name="contact_person"/>
                            </div>
                            <div class="form-group">
                                <label for="plan_id">Select Plan</label>
                                <select class="form-control" id="plan_id" name="plan_id" required="required">
                                    <option value="">-- Select Plan --</option>
                                    <t t-foreach="plans" t-as="plan">
                                        <option t-attf-value="{plan.id}">
                                            <t t-esc="plan.name"/> - $<t t-esc="plan.price_monthly"/>/month
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <button type="button" class="btn btn-primary" onclick="createTenant()">
                                Create Account
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </template>

        <template id="pricing_template" name="SaaS Pricing">
            <div class="container mt-5">
                <h1 class="text-center mb-5">Pricing Plans</h1>
                <div class="row">
                    <t t-foreach="plans" t-as="plan">
                        <div class="col-md-4 mb-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title"><t t-esc="plan.name"/></h5>
                                    <p class="card-text"><t t-esc="plan.description"/></p>
                                    <h3 class="mb-3">
                                        $<t t-esc="plan.price_monthly"/><small>/month</small>
                                    </h3>
                                    <ul class="list-unstyled">
                                        <li>Up to <t t-esc="plan.max_users"/> users</li>
                                        <li><t t-esc="plan.trial_days"/> days free trial</li>
                                    </ul>
                                    <a href="/saas/signup" class="btn btn-primary">Get Started</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </template>

        <template id="dashboard_template" name="SaaS Dashboard">
            <div class="container-fluid mt-5">
                <h1>Dashboard</h1>
                <div class="row">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Plan</h5>
                                <p class="card-text" id="plan_name">--</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Users</h5>
                                <p class="card-text" id="user_count">--</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Status</h5>
                                <p class="card-text" id="tenant_status">--</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>